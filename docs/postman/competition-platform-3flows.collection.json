{
  "info": {
    "name": "Competition Platform - 3 Flows",
    "_postman_id": "b4c48755-3adf-4dfa-8a86-d6ca31b1f002",
    "description": "Auth + Recommendation(Fallback) + Apply-Review flow for graduation project testing.",
