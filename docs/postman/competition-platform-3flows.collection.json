    {
      "name": "3) Apply-Review Flow",
      "item": [
        {
          "name": "Create Application (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('application create status is valid', function () {",
                  "  pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});",
                  "const j = pm.response.json();",
                  "const data = (j && (j.data || j)) || {};",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const appId = data.id || data.applicationId;",
                  "  if (appId) pm.environment.set('applicationId', String(appId));",
                  "  pm.test('applicationId exists after create', function () { pm.expect(pm.environment.get('applicationId')).to.exist; });",
                  "}",
                  "if (pm.response.code === 409) {",
                  "  pm.test('duplicate application is blocked', function () { pm.expect(true).to.eql(true); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_student}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"competitionId\": {{competitionId}},\n  \"teamId\": {{teamId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('teacher login status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "const token = (j && (j.token || (j.data && j.data.token))) || '';",
                  "pm.test('teacher token exists in response', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('token_teacher', token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token_teacher');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{teacherPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Teacher Pending Applications",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_teacher}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/teacher/applications?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teacher",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "const list = (j && j.data && (j.data.records || j.data.list)) || j.data || [];",
                  "pm.test('pending list is array', function () { pm.expect(Array.isArray(list)).to.eql(true); });",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "  const pick = list.slice().sort((a,b)=>(b.id||0)-(a.id||0))[0];",
                  "  if (pick && pick.id) pm.environment.set('applicationId', String(pick.id));",
                  "  pm.test('applicationId saved from pending list', function () { pm.expect(pm.environment.get('applicationId')).to.exist; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Review Application (Teacher Approve)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_teacher}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"reason\": \"通过\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/teacher/applications/{{applicationId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teacher",
                "applications",
                "{{applicationId}}",
                "review"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('review status is valid', function () {",
                  "  pm.expect([200, 400, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "if ([400, 404, 409].includes(pm.response.code)) {",
                  "  pm.test('rerun conflict/not-found is acceptable', function () { pm.expect(true).to.eql(true); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
