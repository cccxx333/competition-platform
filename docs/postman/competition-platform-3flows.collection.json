  "item": [
    {
      "name": "1) Auth Flow",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let seq = parseInt(pm.environment.get('studentSeq') || '4', 10);",
                  "if (!Number.isFinite(seq) || seq < 1) seq = 4;",
                  "const ts = Date.now().toString().slice(-6);",
                  "const username = `s${String(seq).padStart(2, '0')}_${ts}`;",
                  "const email = `${username}@test.com`;",
                  "const password = pm.environment.get('studentPassword') || '123456';",
                  "pm.environment.set('studentUsername', username);",
                  "pm.environment.set('studentEmail', email);",
                  "pm.environment.set('studentPassword', password);",
                  "pm.environment.set('studentSeq', String(seq + 1));",
                  "console.log('register user =', username, email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "const data = (j && (j.data || j)) || {};",
                  "pm.test('register response has user id', function () {",
                  "  pm.expect(data.id, 'id missing').to.exist;",
                  "});",
                  "pm.test('register username matches env', function () {",
                  "  pm.expect(data.username, 'username mismatch').to.eql(pm.environment.get('studentUsername'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "const token = (j && (j.token || (j.data && j.data.token))) || '';",
                  "pm.test('token exists in response', function () {",
                  "  pm.expect(token, 'token missing in response').to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('token_student', token);",
                  "pm.test('token_student exists', function () {",
                  "  pm.expect(pm.environment.get('token_student')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token_student');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Current User (Student)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_student}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "const me = (j && (j.data || j)) || {};",
                  "pm.test('current user has id and username', function () {",
                  "  pm.expect(me.id, 'current user id missing').to.exist;",
                  "  pm.expect(me.username, 'current user username missing').to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('current user equals logged student', function () {",
                  "  pm.expect(me.username).to.eql(pm.environment.get('studentUsername'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
