        {
          "name": "Register Exception User (First Time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{exceptionUsername}}\",\n  \"email\": \"{{exceptionEmail}}\",\n  \"password\": \"{{exceptionPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now().toString().slice(-7);",
                  "const username = `ex_${ts}`;",
                  "pm.environment.set('exceptionUsername', username);",
                  "pm.environment.set('exceptionEmail', `${username}@test.com`);",
                  "if (!pm.environment.get('exceptionPassword')) pm.environment.set('exceptionPassword', '123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('first registration status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
