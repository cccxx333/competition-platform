        {
          "name": "List Competitions (Save competitionId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_student}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/competitions?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "competitions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "let list = [];",
                  "if (Array.isArray(j && j.content)) list = j.content;",
                  "else if (Array.isArray(j && j.data)) list = j.data;",
                  "else if (Array.isArray(j && j.data && j.data.records)) list = j.data.records;",
                  "else if (Array.isArray(j && j.data && j.data.list)) list = j.data.list;",
                  "else if (Array.isArray(j && j.data && j.data.content)) list = j.data.content;",
                  "else if (Array.isArray(j && j.data && j.data.items)) list = j.data.items;",
                  "pm.test('competition list is array', function () { pm.expect(Array.isArray(list)).to.eql(true); });",
                  "pm.test('competition list not empty', function () { pm.expect(list.length).to.be.above(0); });",
                  "if (list.length > 0) pm.environment.set('competitionId', String(list[0].id));",
                  "pm.test('competitionId exists', function () { pm.expect(pm.environment.get('competitionId')).to.exist; });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('competitionId');",
                  "pm.environment.unset('teamId');",
                  "pm.environment.unset('applicationId');",
                  "pm.collectionVariables.unset('competitionId');",
                  "pm.collectionVariables.unset('teamId');",
                  "pm.collectionVariables.unset('applicationId');",
                  "pm.globals.unset('competitionId');",
                  "pm.globals.unset('teamId');",
                  "pm.globals.unset('applicationId');"
                ]
              }
            }
          ]
        },
        {
          "name": "Recommend Teams (Save teamId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_student}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/competitions/{{competitionId}}/teams/recommend?topK=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "competitions",
                "{{competitionId}}",
                "teams",
                "recommend"
              ],
              "query": [
                {
                  "key": "topK",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test('recommend teams response status is valid', function () {",
                  "  pm.expect([200, 400, 404, 409]).to.include(code);",
                  "});",
                  "let list = [];",
                  "try {",
                  "  const j = pm.response.json();",
                  "  list = (j && j.data && (j.data.records || j.data.list)) || j.data || [];",
                  "} catch (e) { list = []; }",
                  "pm.test('team list is array', function () { pm.expect(Array.isArray(list)).to.eql(true); });",
                  "if (code === 200 && Array.isArray(list) && list.length > 0) {",
                  "  pm.environment.set('teamId', String(list[0].id));",
                  "  pm.test('teamId exists', function () { pm.expect(pm.environment.get('teamId')).to.exist; });",
                  "} else {",
                  "  pm.test('no recommendable team, skip apply requests', function () { pm.expect(true).to.eql(true); });",
                  "  postman.setNextRequest('Invalid Path Param (Expect 400)');",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('teamId');",
                  "pm.collectionVariables.unset('teamId');",
                  "pm.globals.unset('teamId');"
                ]
              }
            }
          ]
        },
