  "item": [
    {
      "name": "1) Permission Flow",
      "item": [
        {
          "name": "Unauthenticated Access /users/me (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthenticated request is rejected', function () {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student (Permission Flow)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{applyStudentUsername}}\",\n  \"password\": \"{{applyStudentPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token_student');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student login status is 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "const token = (j && (j.token || (j.data && j.data.token))) || '';",
                  "pm.test('student token exists in response', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('token_student', token);"
                ]
              }
            }
          ]
        },
